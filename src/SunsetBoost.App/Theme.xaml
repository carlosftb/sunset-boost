<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SunsetBoost.App.Controls">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ===== Cores (pôr do sol de Vice) ===== -->
    <Color x:Key="NightColor">#140B2E</Color>
    <Color x:Key="PinkColor">#FF5FA2</Color>
    <Color x:Key="OrangeColor">#FF8A3D</Color>
    <Color x:Key="GoldColor">#FFD166</Color>
    <Color x:Key="CyanColor">#3EE6FF</Color>
    <SolidColorBrush x:Key="Night" Color="#140B2E" />
    <SolidColorBrush x:Key="Ink" Color="#1A0F2E" />
    <SolidColorBrush x:Key="Pink" Color="#FF5FA2" />
    <SolidColorBrush x:Key="Orange" Color="#FF8A3D" />
    <SolidColorBrush x:Key="Gold" Color="#FFD166" />
    <SolidColorBrush x:Key="Cyan" Color="#3EE6FF" />
    <SolidColorBrush x:Key="Mint" Color="#5CFFB0" />
    <SolidColorBrush x:Key="Lavender" Color="#6C5FB0" />
    <SolidColorBrush x:Key="White" Color="#FFF6EE" />
    <SolidColorBrush x:Key="Soft" Color="#CDB9EA" />
    <SolidColorBrush x:Key="Label" Color="#FFB3D4" />
    <SolidColorBrush x:Key="Panel" Color="#B8120826" />
    <SolidColorBrush x:Key="PanelSolid" Color="#C8120826" />
    <SolidColorBrush x:Key="Hairline" Color="#14FFFFFF" />

    <LinearGradientBrush x:Key="CtaBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFD166" Offset="0" />
        <GradientStop Color="#FF8A3D" Offset="0.45" />
        <GradientStop Color="#FF5FA2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CtaActiveBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3EE6FF" Offset="0" />
        <GradientStop Color="#7B6CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFD166" Offset="0" />
        <GradientStop Color="#FF5FA2" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Fontes (do Windows, gratuitas; nada da Rockstar) ===== -->
    <FontFamily x:Key="TitleFont">Impact, Bahnschrift Bold Condensed, Arial Black</FontFamily>
    <FontFamily x:Key="LabelFont">Bahnschrift SemiBold Condensed, Bahnschrift, Arial Narrow</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>

    <DropShadowEffect x:Key="PinkGlow" Color="#FF5FA2" BlurRadius="18" ShadowDepth="0" Opacity="0.85" />
    <DropShadowEffect x:Key="GoldGlow" Color="#FFD166" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />

    <!-- ===== Textos ===== -->
    <Style x:Key="H" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Label}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource White}" />
    </Style>
    <Style x:Key="Small" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Soft}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Painel recortado ===== -->
    <Style x:Key="PanelBox" TargetType="c:CutBorder">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- ===== Abas inclinadas (menu de pausa) ===== -->
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#E9DCFF" />
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="#8C140B2E" Padding="18,4,18,2">
                        <Border.RenderTransform><SkewTransform AngleX="-12" /></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center">
                            <ContentPresenter.RenderTransform><SkewTransform AngleX="12" /></ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#59FF5FA2" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource White}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{StaticResource GoldGlow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Interruptor inclinado ===== -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="20">
                        <Grid.RenderTransform><SkewTransform AngleX="-12" /></Grid.RenderTransform>
                        <Border x:Name="Track" Background="#3A2A5E" CornerRadius="2" />
                        <Border x:Name="Knob" Width="14" Height="14" Background="White" HorizontalAlignment="Left" Margin="3,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Pink}" />
                            <Setter TargetName="Track" Property="Effect" Value="{StaticResource PinkGlow}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Botões ===== -->
    <Style x:Key="NeonButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CtaBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource LabelFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Padding" Value="24,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect" Value="{StaticResource PinkGlow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <c:CutBorder x:Name="B" Cut="Parallelogram" CutSize="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </c:CutBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource White}" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Foreground" Value="#D7C4EF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#33FF5FA2" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barra de rolagem fina ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="#66FF5FA2" /></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Selo de impacto ===== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><SkewTransform AngleX="-12" /></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
